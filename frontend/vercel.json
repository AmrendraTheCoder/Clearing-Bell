{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/rpc", "destination": "https://testnet.hashio.io/api" },
    { "source": "/markets", "destination": "/markets/index.html" },
    { "source": "/auction", "destination": "/auction/index.html" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/issuer", "destination": "/issuer/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
